{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pyragogy/working-patterns/blob/main/data/schema/v0.1/case.schema.json",
  "title": "Working Patterns case record",
  "type": "object",
  "required": ["case_id", "name", "unit_of_analysis", "scale", "environment", "outcome_class", "source_ids", "limitations"],
  "properties": {
    "case_id": {"type":"string", "pattern":"^K[0-9]{2}$"},
    "name": {"type":"string"},
    "unit_of_analysis": {"type":"string"},
    "scale": {"type":"string"},
    "environment": {"type":"string"},
    "duration": {"type":"string"},
    "declared_practice": {"type":["string","null"]},
    "observed_practice": {"type":["string","null"]},
    "outcome_class": {"type":"string"},
    "source_ids": {"type":"array", "items":{"type":"string"}, "minItems":1, "uniqueItems":true},
    "limitations": {"type":"string"}
  },
  "additionalProperties": true
}
