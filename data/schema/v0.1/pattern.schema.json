{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pyragogy/working-patterns/blob/main/data/schema/v0.1/pattern.schema.json",
  "title": "Working Patterns pattern record",
  "type": "object",
  "required": ["pattern_id", "name", "problem", "components", "mechanism_status", "pattern_maturity", "evidence_scope", "assessment"],
  "properties": {
    "pattern_id": {"type":"string", "pattern":"^WP-C[0-9]{3}$"},
    "name": {"type":"string", "minLength":3},
    "problem": {"type":"string", "minLength":10},
    "components": {"type":"array", "minItems":1},
    "mechanism": {"type":["string","null"]},
    "mechanism_status": {"enum":["proposed","plausible","evidenced","contested"]},
    "pattern_maturity": {"enum":["candidate","documented","corroborated","contested","revised","retired"]},
    "evidence_scope": {"enum":["narrow-context","multi-context","cross-domain"]},
    "assessment": {"type":"string"},
    "outcome_domains": {"type":"array", "items":{"type":"string"}, "uniqueItems":true},
    "cost_domains": {"type":"array", "items":{"type":"string"}, "uniqueItems":true}
  },
  "additionalProperties": true
}
