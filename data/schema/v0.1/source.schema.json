{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pyragogy/working-patterns/blob/main/data/schema/v0.1/source.schema.json",
  "title": "Working Patterns source record",
  "type": "object",
  "required": ["source_id", "authors", "year", "title", "url", "document_kind", "access", "licence_status"],
  "properties": {
    "source_id": {"type":"string", "pattern":"^(SC[0-9]{3}|S[0-9]{2})$"},
    "authors": {"type":"array", "items":{"type":"string"}, "minItems":1},
    "year": {"type":["integer","null"]},
    "title": {"type":"string"},
    "url": {"type":"string", "format":"uri"},
    "document_kind": {"type":"string"},
    "access": {"type":"string"},
    "licence": {"type":["string","null"]},
    "licence_status": {"type":"string"}
  },
  "additionalProperties": true
}
